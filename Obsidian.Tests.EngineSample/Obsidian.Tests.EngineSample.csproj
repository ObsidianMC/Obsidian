<Project Sdk="Microsoft.NET.Sdk.Razor">

	<!-- The engine sample, kept as a test fixture: a mod built against the public API alone, which Obsidian.Tests and
	     the client's tests pack and load like a real one (see README.md). The documented sample mods are
	     ObsidianMC/ObsidianMod and ObsidianMC/ObsidianPlugin. The Razor SDK compiles its screens' .razor components
	     into its assembly. -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>EngineSample</AssemblyName>
		<RootNamespace>EngineSample</RootNamespace>
		<EnablePreviewFeatures>true</EnablePreviewFeatures>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>false</IsPackable>
		<!-- A mod has no web assets, so its output is only what its archive holds. -->
		<StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
	</PropertyGroup>

	<!-- The server or client provides the API at runtime, so its assemblies aren't copied beside the plugin's.
	     Obsidian.API doesn't pass on its reference to Obsidian.Nbt, whose types block entities save with, so it's
	     referenced too. Obsidian.API.Client is the client half, for the mod's screens; servers ship it as well. It
	     brings the ASP.NET Core framework, whose Blazor components Razor screens are built on. -->
	<ItemGroup>
		<ProjectReference Include="..\Obsidian.API\Obsidian.API.csproj" Private="false" />
		<ProjectReference Include="..\Obsidian.API.Client\Obsidian.API.Client.csproj" Private="false" />
		<ProjectReference Include="..\Obsidian.Nbt\Nbt\Obsidian.Nbt.csproj" Private="false" />
	</ItemGroup>

	<!-- What a plugin archive holds besides the assembly: its metadata, its data pack files and its client assets. -->
	<ItemGroup>
		<None Include="obsidian.mod.json" CopyToOutputDirectory="PreserveNewest" />
		<None Include="data\**\*.json" CopyToOutputDirectory="PreserveNewest" />
		<None Include="assets\**\*.json;assets\**\*.png" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
