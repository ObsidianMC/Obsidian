<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>annotations</Nullable>
		<EnablePreviewFeatures>true</EnablePreviewFeatures>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<PropertyGroup>
		<!-- The Minecraft version Obsidian implements. Obsidian.AssetGenerator generates Assets from its server jar. -->
		<MinecraftVersion>26.3</MinecraftVersion>
		<!-- Temporary: the older Minecraft version whose loot tables and worldgen Obsidian runs on, since its models
		     don't read the current version's yet. Obsidian.AssetGenerator writes them to Assets\legacy-<version>, which
		     is embedded under the names of the assets they stand in for, and the server extracts this version's
		     structure templates (ServerConstants.LegacyVersion). Phases 4 (loot) and 5 (worldgen) of
		     docs/porting-26.3-plan.md remove it, together with Datagen.LegacyTags and the generated LegacyWorldgenTags
		     bridge: legacy tag references use obsidian_legacy with legacy contents/current ids and never sync to clients. -->
		<LegacyMinecraftVersion>1.21.11</LegacyMinecraftVersion>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>LegacyMinecraftVersion</_Parameter1>
			<_Parameter2>$(LegacyMinecraftVersion)</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DefineConstants>TRACE</DefineConstants>
		<Deterministic>False</Deterministic>
	</PropertyGroup>

	<PropertyGroup>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<Company>Obsidian Team</Company>
		<Authors>Obsidian Team</Authors>
		<PackageLicenseExpression></PackageLicenseExpression>
		<Description>A C# implementation of the Minecraft server protocol (.NET)</Description>
		<PackageProjectUrl>https://github.com/ObsidianMC/Obsidian</PackageProjectUrl>
		<RepositoryUrl>https://github.com/ObsidianMC/Obsidian</RepositoryUrl>
		<PackageTags>minecraft-server-protocol minecraft-server minecraft</PackageTags>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
	</PropertyGroup>

	<PropertyGroup Condition="'$(UseArtifactsOutput)' == 'true'">
		<CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
	</PropertyGroup>

	<PropertyGroup>
		<Deterministic>False</Deterministic>
		<SourceRevisionId>$(GIT_SHA)</SourceRevisionId>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\.editorconfig" Link=".editorconfig" />
		<None Include="..\LICENSE">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<!-- Obsidian's convention (c:) tags, merged with vanilla's tags like a built-in data pack. -->
		<EmbeddedResource Include="Registries\convention_tags.json" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="NuGet.Versioning" Version="7.0.1" />
		<PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.14.0" />
		<PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
		<PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.14.0" />
		<PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.14.0" />
		<PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.14.0" />
		<PackageReference Include="SharpNoise" Version="0.12.1.1" />
		<PackageReference Include="System.IO.Hashing" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- An artifacts build may follow an in-tree build that left generated sources in the checkout. -->
		<Compile Remove="Generated/**/*.cs;$(CompilerGeneratedFilesOutputPath)/**/*.cs" />
	</ItemGroup>

	<!-- Assets is generated when Obsidian.AssetGenerator builds, so it's included once the reference is built rather than
	     at evaluation, when a fresh clone has none. -->
	<Target Name="IncludeVanillaAssets" AfterTargets="ResolveProjectReferences">
		<ItemGroup>
			<!-- Biome parameter lists, configured carvers, block physics, collision shapes and registry ids are only read at runtime; keep them away from the source generators. -->
			<AdditionalFiles Include="Assets\**\*.json" Exclude="Assets\biome_parameters\**;Assets\configured_carver\**;Assets\legacy-*\biome_parameters\**;Assets\legacy-*\configured_carver\**;Assets\legacy-*\block_states.json;Assets\block_physics.json;Assets\collision_shapes.json;Assets\registry_ids.json" />
			<EmbeddedResource Include="Assets\**\*.*" Exclude="Assets\.generated-*;Assets\legacy-*\**" />
			<!-- The legacy loot and worldgen assets, under the names of the current version's assets they stand in for
			     (Obsidian.Assets.worldgen.structures.nether.json). -->
			<_LegacyVanillaAsset Include="Assets\legacy-$(LegacyMinecraftVersion)\**\*.*" Exclude="Assets\legacy-$(LegacyMinecraftVersion)\block_states.json" />
			<EmbeddedResource Include="@(_LegacyVanillaAsset)"
			                  LogicalName="Obsidian.Assets.$([System.String]::Copy('%(_LegacyVanillaAsset.RecursiveDir)').Replace('\', '.').Replace('/', '.'))%(_LegacyVanillaAsset.Filename)%(_LegacyVanillaAsset.Extension)" />
		</ItemGroup>
	</Target>

	<ItemGroup>
		<ProjectReference Include="..\Obsidian.AssetGenerator\Obsidian.AssetGenerator.csproj" ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\Obsidian.API\Obsidian.API.csproj" />
		<!-- The server never calls the client API, but ships it so that mods whose plugin class implements
		     IClientPlugin load on servers too. -->
		<ProjectReference Include="..\Obsidian.API.Client\Obsidian.API.Client.csproj" />
      <ProjectReference Include="..\Obsidian.Nbt\Nbt\Obsidian.Nbt.csproj" />
		<ProjectReference Include="..\Obsidian.SourceGenerators\Obsidian.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>
</Project>
