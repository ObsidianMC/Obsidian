<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<EnablePreviewFeatures>true</EnablePreviewFeatures>
		<IsPackable>false</IsPackable>
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
	</PropertyGroup>

	<PropertyGroup Condition="'$(UseArtifactsOutput)' == 'true'">
		<CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Assets\bigtest.nbt" />
		<None Remove="Assets\daylight_detector.json" />
		<None Remove="Assets\fluid_scenarios.json" />
		<None Remove="Assets\redstone_scenarios.json" />
		<None Remove="Assets\vanilla_worldgen.json" />
		<None Remove="Assets\vanilla_worldgen_26.3\**" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Assets\bigtest.nbt" />
		<EmbeddedResource Include="Assets\daylight_detector.json" />
		<EmbeddedResource Include="Assets\fluid_scenarios.json" />
		<EmbeddedResource Include="Assets\sulfur_scenarios.json" />
		<EmbeddedResource Include="Assets\sulfur_fixtures.json" />
		<EmbeddedResource Include="Assets\redstone_scenarios.json" />
		<EmbeddedResource Include="Assets\vanilla_worldgen.json" />
		<!-- A folder of files, embedded by their paths in it (VanillaWorldgenCaptures). -->
		<EmbeddedResource Include="Assets\vanilla_worldgen_26.3\**\*.json">
			<LogicalName>Obsidian.Tests.Assets.vanilla_worldgen_26.3/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="Assets\block_loot.json" />
		<EmbeddedResource Include="Assets\entity_loot.json" />
		<EmbeddedResource Include="Assets\context_numbers.json" />
		<EmbeddedResource Include="Assets\container_loot.json" />
		<EmbeddedResource Include="Assets\progress-*.*" Exclude="Assets\progress-reference.md" />
	</ItemGroup>

	<ItemGroup>
		<!-- An artifacts build may follow an in-tree build that left generated sources in the checkout. -->
		<Compile Remove="Generated/**/*.cs;$(CompilerGeneratedFilesOutputPath)/**/*.cs" />
	</ItemGroup>

  <ItemGroup>
    <PackageReference Include="MartinCostello.Logging.XUnit" Version="0.7.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="SharpNoise.Utilities" Version="0.12.1.1" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Obsidian\Obsidian.csproj" />
		<ProjectReference Include="..\Obsidian.Porting\Obsidian.Porting.csproj" />
	</ItemGroup>

	<!-- Temporary until Phase 5 re-records vanilla_worldgen.json on 26.3. Include after asset generation so a clean
	     checkout works too; the table is embedded only in the test assembly. -->
	<Target Name="IncludeLegacyBlockStates" AfterTargets="ResolveProjectReferences">
		<XmlPeek XmlInputPath="$(MSBuildThisFileDirectory)..\Obsidian\Obsidian.csproj"
		         Query="/Project/PropertyGroup/LegacyMinecraftVersion/text()">
			<Output TaskParameter="Result" PropertyName="LegacyMinecraftVersion" />
		</XmlPeek>
		<ItemGroup>
			<EmbeddedResource Include="..\Obsidian\Assets\legacy-$(LegacyMinecraftVersion)\block_states.json"
			                  LogicalName="Obsidian.Tests.Assets.legacy_block_states.json" />
		</ItemGroup>
	</Target>

	<!-- The probe plugin is a plugin project too: its data folder is generated from, like a plugin's, and packed into
	     its archive by the tests. -->
	<ItemGroup>
		<ProjectReference Include="..\Obsidian.SourceGenerators\Obsidian.SourceGenerators.csproj"
		                  OutputItemType="Analyzer"
		                  ReferenceOutputAssembly="false" />
		<AdditionalFiles Include="data\**\*.json" />
		<None Include="data\**\*.json" CopyToOutputDirectory="PreserveNewest" />
		<None Include="Assets\vanilla-26.3-world\**" Exclude="Assets\vanilla-26.3-world\README.md" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<!-- The engine sample fixture, built first; its output, laid out like its archive, is copied into EngineSample/,
	     which the tests pack and load like a real plugin's. -->
	<ItemGroup>
		<ProjectReference Include="..\Obsidian.Tests.EngineSample\Obsidian.Tests.EngineSample.csproj"
		                  OutputItemType="EngineSampleAssembly"
		                  ReferenceOutputAssembly="false" />
	</ItemGroup>

	<Target Name="CopyEngineSample" AfterTargets="Build">
		<PropertyGroup>
			<EngineSampleOutput>@(EngineSampleAssembly->'%(RootDir)%(Directory)')</EngineSampleOutput>
		</PropertyGroup>

		<ItemGroup>
			<EngineSampleFiles Include="$(EngineSampleOutput)**\*" />
		</ItemGroup>

		<Copy SourceFiles="@(EngineSampleFiles)"
		      DestinationFiles="@(EngineSampleFiles->'$(OutDir)EngineSample\%(RecursiveDir)%(Filename)%(Extension)')"
		      SkipUnchangedFiles="true" />
	</Target>

</Project>
