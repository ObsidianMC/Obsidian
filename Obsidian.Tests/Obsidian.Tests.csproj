<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<EnablePreviewFeatures>true</EnablePreviewFeatures>
		<IsPackable>false</IsPackable>
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
	</PropertyGroup>

	<PropertyGroup Condition="'$(UseArtifactsOutput)' == 'true'">
		<CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Assets\bigtest.nbt" />
		<None Remove="Assets\fluid_scenarios.json" />
		<None Remove="Assets\redstone_scenarios.json" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Assets\bigtest.nbt" />
		<EmbeddedResource Include="Assets\fluid_scenarios.json" />
		<EmbeddedResource Include="Assets\redstone_scenarios.json" />
		<EmbeddedResource Include="Assets\block_loot.json" />
		<EmbeddedResource Include="Assets\entity_loot.json" />
		<EmbeddedResource Include="Assets\update-recipes.bin" />
		<EmbeddedResource Include="Assets\progress-*.*" />
	</ItemGroup>

	<ItemGroup>
		<!-- An artifacts build may follow an in-tree build that left generated sources in the checkout. -->
		<Compile Remove="Generated/**/*.cs;$(CompilerGeneratedFilesOutputPath)/**/*.cs" />
	</ItemGroup>

  <ItemGroup>
    <PackageReference Include="MartinCostello.Logging.XUnit" Version="0.7.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="SharpNoise.Utilities" Version="0.12.1.1" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Obsidian\Obsidian.csproj" />
		<ProjectReference Include="..\Obsidian.Porting\Obsidian.Porting.csproj" />
	</ItemGroup>

	<!-- The probe plugin is a plugin project too: its data folder is generated from, like a plugin's, and packed into
	     its archive by the tests. -->
	<ItemGroup>
		<ProjectReference Include="..\Obsidian.SourceGenerators\Obsidian.SourceGenerators.csproj"
		                  OutputItemType="Analyzer"
		                  ReferenceOutputAssembly="false" />
		<AdditionalFiles Include="data\**\*.json" />
		<None Include="data\**\*.json" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<!-- The engine sample fixture, built first; its output, laid out like its archive, is copied into EngineSample/,
	     which the tests pack and load like a real plugin's. -->
	<ItemGroup>
		<ProjectReference Include="..\Obsidian.Tests.EngineSample\Obsidian.Tests.EngineSample.csproj"
		                  OutputItemType="EngineSampleAssembly"
		                  ReferenceOutputAssembly="false" />
	</ItemGroup>

	<Target Name="CopyEngineSample" AfterTargets="Build">
		<PropertyGroup>
			<EngineSampleOutput>@(EngineSampleAssembly->'%(RootDir)%(Directory)')</EngineSampleOutput>
		</PropertyGroup>

		<ItemGroup>
			<EngineSampleFiles Include="$(EngineSampleOutput)**\*" />
		</ItemGroup>

		<Copy SourceFiles="@(EngineSampleFiles)"
		      DestinationFiles="@(EngineSampleFiles->'$(OutDir)EngineSample\%(RecursiveDir)%(Filename)%(Extension)')"
		      SkipUnchangedFiles="true" />
	</Target>

</Project>
