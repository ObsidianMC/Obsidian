<Project Sdk="Microsoft.NET.Sdk">

	<!-- Times the Mojang generator's stages and checks its output against recorded hashes; see Program.cs for usage. -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<RootNamespace>WorldgenBench</RootNamespace>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<EnablePreviewFeatures>true</EnablePreviewFeatures>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
	</PropertyGroup>

	<ItemGroup>
		<!-- Like Obsidian.ConsoleApp, so timings reflect the server's tiering. -->
		<RuntimeHostConfigurationOption Include="System.Runtime.TieredCompilation.CallCountingDelayMs" Value="0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Obsidian\Obsidian.csproj" />
		<!-- One harness for replay tests and the offline block probe; no test assembly dependency. -->
		<Compile Include="..\Obsidian.Tests\RedstoneTestWorld.cs" Link="RedstoneTestWorld.cs" />
		<!-- The block entity and live level cases run a real level, built the way the tests build one. -->
		<Compile Include="..\Obsidian.Tests\Fakes\FakeInfrastructure.cs" Link="FakeInfrastructure.cs" />
		<!-- The packet case runs a real server's level with a connected player, as the tests do. -->
		<Compile Include="..\Obsidian.Tests\Fakes\RealServerInfrastructure.cs" Link="RealServerInfrastructure.cs" />
	</ItemGroup>
</Project>
