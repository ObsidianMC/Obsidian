<Project Sdk="Microsoft.NET.Sdk">

	<!-- Obsidian's engine sample: a plugin built against the public API alone, as a mod is, which Obsidian.Tests packs
	     and loads through the plugin manager (see README.md). -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<EnablePreviewFeatures>true</EnablePreviewFeatures>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<!-- The server or client provides the API at runtime, so its assemblies aren't copied beside the plugin's.
	     Obsidian.API doesn't pass on its reference to Obsidian.Nbt, whose types block entities save with, so it's
	     referenced too. Obsidian.API.Client is the client half, for the mod's screens; servers ship it as well. -->
	<ItemGroup>
		<ProjectReference Include="..\..\Obsidian.API\Obsidian.API.csproj" Private="false" />
		<ProjectReference Include="..\..\Obsidian.API.Client\Obsidian.API.Client.csproj" Private="false" />
		<ProjectReference Include="..\..\Obsidian.Nbt\Nbt\Obsidian.Nbt.csproj" Private="false" />
	</ItemGroup>

	<!-- What a plugin archive holds besides the assembly: its metadata and its data pack files. -->
	<ItemGroup>
		<None Include="obsidian.mod.json" CopyToOutputDirectory="PreserveNewest" />
		<None Include="data\**\*.json" CopyToOutputDirectory="PreserveNewest" />
		<None Include="assets\**\*.json" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
