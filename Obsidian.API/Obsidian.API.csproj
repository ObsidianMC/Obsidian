<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<EnablePreviewFeatures>True</EnablePreviewFeatures>
		<Nullable>annotations</Nullable>
		<AssemblyName>Obsidian.API</AssemblyName>
		<RootNamespace>Obsidian.API</RootNamespace>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<Version>1.0.0</Version>
		<Authors>Obsidian Team</Authors>
		<Company>Obsidian Team</Company>
		<Product>Obsidian</Product>
		<Description>The plugin API for Obsidian, a Minecraft server.</Description>
		<PackageProjectUrl>https://github.com/ObsidianMC/Obsidian</PackageProjectUrl>
		<RepositoryUrl>https://github.com/ObsidianMC/Obsidian</RepositoryUrl>
		<PackageTags>minecraft obsidian api plugin plugins</PackageTags>
		<PackageIconUrl>https://i.imgur.com/jU1lkP4.png</PackageIconUrl>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<AssemblyVersion>1.0.0</AssemblyVersion>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<NoWarn>1591</NoWarn>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Title>Obsidian Plugin API</Title>
		<PackageIcon>icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<PropertyGroup Condition="'$(UseArtifactsOutput)' == 'true'">
		<CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
	</PropertyGroup>

	<!-- Obsidian.AssetGenerator generates ..\Obsidian\Assets when it builds, so the assets are included once the reference
	     is built rather than at evaluation, when a fresh clone has none. -->
	<Target Name="IncludeVanillaAssets" AfterTargets="ResolveProjectReferences">
		<ItemGroup>
			<AdditionalFiles Include="..\Obsidian\Assets\blocks.json" Link="Assets\blocks.json" />
			<AdditionalFiles Include="..\Obsidian\Assets\items.json" Link="Assets\items.json" />
			<AdditionalFiles Include="..\Obsidian\Assets\fluids.json" Link="Assets\fluids.json" />
			<AdditionalFiles Include="..\Obsidian\Assets\entities.json" Link="Assets\entities.json" />

			<AdditionalFiles Include="..\Obsidian\Assets\command_parsers.json" Link="Assets\command_parsers.json" />
			<AdditionalFiles Include="..\Obsidian\Assets\sounds.json" Link="Assets\sounds.json" />
			<AdditionalFiles Include="..\Obsidian\Assets\tags.json" Link="Assets\tags.json" />
			<AdditionalFiles Include="..\Obsidian\Assets\path_type_malus.json" Link="Assets\path_type_malus.json" />

			<AdditionalFiles Include="..\Obsidian\Assets\Codecs\**\*.json" LinkBase="Assets\Codecs\" />

			<AdditionalFiles Include="..\Obsidian\Assets\worldgen\**\*.*" LinkBase="Assets\worldgen\" />
			<AdditionalFiles Include="..\Obsidian\Assets\enums.json" Link="Assets\enums.json" />
			<AdditionalFiles Include="..\Obsidian\Assets\item_components.json" Link="Assets\item_components.json" />
			<EmbeddedResource Include="..\Obsidian\Assets\registry_ids.json"
			                  LogicalName="Obsidian.API.registry_ids.json" />
			<EmbeddedResource Include="..\Obsidian\Assets\component_registry_ids.json"
			                  LogicalName="Obsidian.API.component_registry_ids.json" />
			<AdditionalFiles Include="..\Obsidian\Assets\loot_table\*.json" LinkBase="Assets\loot_table\" />
			<AdditionalFiles Include="..\Obsidian\Assets\enchantments.json" Link="Assets\enchantments.json" />
			<AdditionalFiles Include="..\Obsidian\Assets\instruments.json" Link="Assets\instruments.json" />
			<AdditionalFiles Include="..\Obsidian\Assets\packet_types.json" Link="Assets\packet_types.json" />
		</ItemGroup>
	</Target>

	<ItemGroup>
		<!-- An artifacts build may follow an in-tree build that left generated sources in the checkout. -->
		<Compile Remove="Generated/**/*.cs;$(CompilerGeneratedFilesOutputPath)/**/*.cs" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\.editorconfig" Link=".editorconfig" />
		<None Include="..\icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\LICENSE">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<!-- The host supplies API dependencies; mods compile against them but don't publish their runtime assets. -->
		<PackageReference Include="CommunityToolkit.HighPerformance" Version="8.4.0" ExcludeAssets="runtime" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0">
			<ExcludeAssets>runtime</ExcludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0">
			<ExcludeAssets>runtime</ExcludeAssets>
		</PackageReference>
		<PackageReference Include="SharpNoise" Version="0.12.1.1">
			<ExcludeAssets>runtime</ExcludeAssets>
		</PackageReference>
	</ItemGroup>

	<!-- The API's public types use Obsidian.Nbt's (codecs, block entity saves), so the package carries the Obsidian.Nbt
	     assembly it was built with, beside its own, rather than depending on a separately published Nbt nightly that
	     may not match the submodule. Mods then compile against both from this package alone. -->
	<PropertyGroup>
		<TargetsForTfmSpecificBuildOutput>
			$(TargetsForTfmSpecificBuildOutput);PackNbtWithApi
		</TargetsForTfmSpecificBuildOutput>
	</PropertyGroup>

	<Target Name="PackNbtWithApi" DependsOnTargets="ResolveReferences">
		<ItemGroup>
			<BuildOutputInPackage Include="@(ReferenceCopyLocalPaths)"
			                      Condition="'%(Filename)' == 'Obsidian.Nbt' And '%(Extension)' != '.pdb'" />
		</ItemGroup>
	</Target>

	<ItemGroup>
		<ProjectReference Include="..\Obsidian.AssetGenerator\Obsidian.AssetGenerator.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
      <ProjectReference Include="..\Obsidian.Nbt\Nbt\Obsidian.Nbt.csproj" PrivateAssets="all" />
		<ProjectReference Include="..\Obsidian.SourceGenerators\Obsidian.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>
</Project>
