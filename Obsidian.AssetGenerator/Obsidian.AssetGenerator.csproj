<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<PropertyGroup>
		<!-- The generated assets Obsidian.API and Obsidian read. Obsidian.csproj sets their Minecraft version. -->
		<VanillaAssetsDirectory>$(MSBuildThisFileDirectory)..\Obsidian\Assets\</VanillaAssetsDirectory>
		<!-- The downloaded server jars and data generator output, per version: a per-user cache that every checkout shares,
		     so a new worktree doesn't download and run the data generators again. Set VanillaWorkDirectory (with -p or
		     as an environment variable) to use another. -->
		<VanillaCache Condition="'$(OS)' == 'Windows_NT'">$(LOCALAPPDATA)\Obsidian</VanillaCache>
		<VanillaCache Condition="'$(OS)' != 'Windows_NT' and '$(XDG_CACHE_HOME)' != ''">$(XDG_CACHE_HOME)/obsidian</VanillaCache>
		<VanillaCache Condition="'$(VanillaCache)' == ''">$(HOME)/.cache/obsidian</VanillaCache>
		<VanillaWorkDirectory Condition="'$(VanillaWorkDirectory)' == ''">$(VanillaCache)/vanilla</VanillaWorkDirectory>
		<VanillaWorkDirectory>$([MSBuild]::NormalizeDirectory('$(VanillaWorkDirectory)'))</VanillaWorkDirectory>
		<!-- This checkout's runs against the cached servers: intermediate files and capture worlds. -->
		<VanillaScratchDirectory>$([MSBuild]::NormalizeDirectory(
			'$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', 'vanilla-scratch'))</VanillaScratchDirectory>
	</PropertyGroup>

	<ItemGroup>
		<!-- Capture source inputs before the build adds generated assembly attributes under obj. -->
		<!-- The capture driver only runs on request (CaptureVanillaWorldgen), so editing it doesn't regenerate the
		     assets. -->
		<VanillaGeneratorInput Include="@(Compile)" Exclude="WorldgenCaptures.cs;WorldgenFixtureFiles.cs" />
		<VanillaDumperInput Include="Java\**\*.java;Java\**\*.json" />
		<None Update="@(VanillaDumperInput)" CopyToOutputDirectory="PreserveNewest" />
		<!-- On-request captures (CaptureVanillaWorldgen); not asset inputs, so editing them doesn't regenerate the assets. -->
		<None Update="Captures\**\*.java" CopyToOutputDirectory="PreserveNewest" />
		<UpToDateCheckOutput Include="$(VanillaAssetsDirectory)collision_shapes.json" />
	</ItemGroup>

	<Target Name="ReadMinecraftVersion">
		<XmlPeek XmlInputPath="$(MSBuildThisFileDirectory)..\Obsidian\Obsidian.csproj"
		         Query="/Project/PropertyGroup/MinecraftVersion/text()">
			<Output TaskParameter="Result" PropertyName="MinecraftVersion" />
		</XmlPeek>
		<Error Condition="'$(MinecraftVersion)' == ''" Text="Obsidian.csproj doesn't set MinecraftVersion." />
		<XmlPeek XmlInputPath="$(MSBuildThisFileDirectory)..\Obsidian\Obsidian.csproj"
		         Query="/Project/PropertyGroup/LegacyMinecraftVersion/text()">
			<Output TaskParameter="Result" PropertyName="LegacyMinecraftVersion" />
		</XmlPeek>
		<Error Condition="'$(LegacyMinecraftVersion)' == ''" Text="Obsidian.csproj doesn't set LegacyMinecraftVersion." />
		<PropertyGroup>
			<VanillaAssetsStamp>$(VanillaAssetsDirectory).generated-$(MinecraftVersion)-legacy-$(LegacyMinecraftVersion)</VanillaAssetsStamp>
			<VanillaLegacyAssetsDirectory>$(VanillaAssetsDirectory)legacy-$(LegacyMinecraftVersion)\</VanillaLegacyAssetsDirectory>
		</PropertyGroup>
		<ItemGroup>
			<VanillaAssetsOutput Include="$(VanillaAssetsStamp)" />
			<VanillaAssetsOutput Include="$(VanillaAssetsDirectory)version.json" />
			<VanillaAssetsOutput Include="$(VanillaAssetsDirectory)worldgen_26_3\noise_settings\overworld.json" />
			<VanillaAssetsOutput Include="$(VanillaAssetsDirectory)worldgen_26_3\biome_parameters\overworld.json" />
			<VanillaAssetsOutput Include="$(VanillaAssetsDirectory)worldgen_26_3\dimension_type\overworld.json" />
			<VanillaAssetsOutput Include="$(VanillaAssetsDirectory)item-components-$(MinecraftVersion).json" />
			<VanillaAssetsOutput Include="$(VanillaAssetsDirectory)client-entity-metadata-$(MinecraftVersion).json" />
			<VanillaAssetsOutput Include="$(VanillaAssetsDirectory)client-screens-$(MinecraftVersion).json" />
			<VanillaAssetsOutput Include="$(VanillaAssetsDirectory)client-movement-$(MinecraftVersion).json" />
			<VanillaAssetsOutput Include="$(VanillaAssetsDirectory)join-payloads-$(MinecraftVersion).json" />
			<VanillaAssetsOutput Include="$(VanillaAssetsDirectory)data-systems-$(MinecraftVersion).json" />
			<VanillaAssetsOutput Include="$(VanillaAssetsDirectory)villager-trades-$(MinecraftVersion).json" />
			<VanillaAssetsOutput Include="$(VanillaAssetsDirectory)villager_trades.json" />
			<VanillaAssetsOutput Include="$(VanillaAssetsDirectory)synced_registries.json" />
			<VanillaAssetsOutput Include="$(VanillaAssetsDirectory)item_stacked_on_classes.json" />
			<VanillaAssetsOutput Include="$(VanillaAssetsDirectory)item_other_stacked_on_classes.json" />
			<VanillaAssetsOutput Include="$(VanillaAssetsDirectory)item_container_fit_classes.json" />
			<VanillaAssetsOutput Include="$(VanillaAssetsDirectory)item_block_classes.json" />
			<VanillaAssetsOutput Include="$(VanillaAssetsDirectory)collision_shapes.json" />
			<VanillaAssetsOutput Include="$(VanillaAssetsDirectory)block_sounds.json" />
			<VanillaAssetsOutput Include="$(VanillaAssetsDirectory)block_loot_tables.json" />
			<VanillaAssetsOutput Include="$(VanillaAssetsDirectory)loot_table\blocks.json" />
			<VanillaAssetsOutput Include="$(VanillaAssetsDirectory)loot_table\entities.json" />
			<VanillaAssetsOutput Include="$(VanillaAssetsDirectory)predicate.json" />
			<VanillaAssetsOutput Include="$(VanillaAssetsDirectory)context_int_provider.json" />
			<VanillaAssetsOutput Include="$(VanillaAssetsDirectory)context_float_provider.json" />
			<VanillaAssetsOutput Include="$(VanillaLegacyAssetsDirectory)block_states.json" />
		</ItemGroup>
	</Target>

	<!-- Runs after every build of the generator, which Obsidian.API and Obsidian reference so that it runs before they
	     compile. Source inputs keep current assets reusable across configurations and fresh output directories. -->
	<Target Name="GenerateVanillaAssets" AfterTargets="Build" DependsOnTargets="ReadMinecraftVersion"
	        Inputs="$(MSBuildProjectFullPath);@(VanillaGeneratorInput);@(VanillaDumperInput)"
	        Outputs="@(VanillaAssetsOutput)">
		<PropertyGroup>
			<VanillaAssetsCommand>dotnet &quot;$(TargetPath)&quot; $(MinecraftVersion) $(LegacyMinecraftVersion)</VanillaAssetsCommand>
			<VanillaAssetsCommand>$(VanillaAssetsCommand) &quot;$(VanillaWorkDirectory).&quot;</VanillaAssetsCommand>
			<VanillaAssetsCommand>$(VanillaAssetsCommand) &quot;$(VanillaScratchDirectory).&quot;</VanillaAssetsCommand>
			<VanillaAssetsCommand>$(VanillaAssetsCommand) &quot;$(VanillaAssetsDirectory).&quot;</VanillaAssetsCommand>
		</PropertyGroup>

		<!-- Java logs warnings to stderr (e.g. deprecated Unsafe use); failures still fail by exit code. -->
		<Exec IgnoreStandardErrorWarningFormat="true" Command="$(VanillaAssetsCommand)" />
		<!-- Some outputs keep older times: version.json the jar entry's, and copied data generator output the cached
		     run's. Touch them all, so that sources checked out after those times don't regenerate on every build. -->
		<Touch Files="$(VanillaAssetsStamp)" AlwaysCreate="true" />
		<Touch Files="@(VanillaAssetsOutput)" />
	</Target>

	<!-- Re-records the 26.3 vanilla worldgen references the parity tests replay, in place, with the Minecraft version's
	     server (docs/vanilla-captures.md). Slow, so only on request:
	     dotnet build Obsidian.AssetGenerator -t:CaptureVanillaWorldgen -->
	<PropertyGroup>
		<VanillaWorldgenFixture>$(MSBuildThisFileDirectory)..\Obsidian.Tests\Assets\vanilla_worldgen_26.3</VanillaWorldgenFixture>
	</PropertyGroup>

	<Target Name="CaptureVanillaWorldgen" DependsOnTargets="Build;ReadMinecraftVersion">
		<PropertyGroup>
			<VanillaCaptureCommand>dotnet &quot;$(TargetPath)&quot; capture-worldgen $(MinecraftVersion)</VanillaCaptureCommand>
			<VanillaCaptureCommand>$(VanillaCaptureCommand) &quot;$(VanillaWorkDirectory).&quot;</VanillaCaptureCommand>
			<VanillaCaptureCommand>$(VanillaCaptureCommand) &quot;$(VanillaScratchDirectory).&quot;</VanillaCaptureCommand>
			<VanillaCaptureCommand>$(VanillaCaptureCommand) &quot;$(VanillaWorldgenFixture)&quot;</VanillaCaptureCommand>
		</PropertyGroup>

		<Exec IgnoreStandardErrorWarningFormat="true" Command="$(VanillaCaptureCommand)" />
	</Target>
</Project>
