/**
 * Re-records the vanilla worldgen and structure references of Obsidian's parity tests
 * (Obsidian.Tests/Assets/vanilla_worldgen.json); WorldgenCaptures.cs runs it (docs/vanilla-captures.md). Resolve with
 * FixtureSource, then run in an empty directory with the server's class path and
 * {@code --add-opens java.base/java.lang=ALL-UNNAMED}, twice per world. First
 * {@code <fixture json> <seed> <generate structures> <version> create} creates and saves the world (picking its spawn
 * generates chunks around it), then the caller deletes its chunks ({@code region}, {@code entities} and {@code poi}
 * folders), then {@code <fixture json> <seed> <generate structures> <version>} captures. Worlds without cases exit right
 * away.
 *
 * <p>It runs a headless vanilla dedicated server in this JVM and has the server's own chunk map generate every chunk: a
 * case asks for chunks at the status it captures (SURFACE, CARVERS, FEATURES, LIGHT), in the order the case describes,
 * on the server thread, so no tick runs (and no chunk unloads) in between, and fails if a chunk was generated further
 * before. Full chunks of a server world are force-loaded instead, with ticks frozen. Only the fixture's cases for this
 * world are recaptured, and the fixture is rewritten in place.
 */
class WorldgenCaptures {
    // Which world (structures on or off) each section's cases are captured in.
    static final Map<String, Boolean> SECTIONS = new LinkedHashMap<>();
    static {
        // Lit chunks come before full chunks, which decorate their neighbors in the server's order.
        for (var name : List.of("router", "biomes", "chunks", "carvedChunks", "decoratedChunks", "litChunks", "fullChunks", "spawns"))
            SECTIONS.put(name, false);
        for (var name : List.of("structurePieces", "structureBlocks", "treasureMaps"))
            SECTIONS.put(name, true);
    }

    // Obsidian's class for each vanilla structure piece type (by registry id), which the piece list hashes start with.
    static final Map<String, String> PIECE_CLASSES = new HashMap<>();
    static {
        String[][] pieces = {
            {"jigsaw", "PoolElementStructurePiece"},
            {"mscorridor", "MineshaftCorridor"}, {"mscrossing", "MineshaftCrossing"}, {"msroom", "MineshaftRoom"},
            {"msstairs", "MineshaftStairs"},
            {"shcc", "ChestCorridor"}, {"shfc", "FillerCorridor"}, {"sh5c", "FiveCrossing"}, {"shlt", "LeftTurn"},
            {"shli", "Library"}, {"shpr", "PortalRoom"}, {"shph", "PrisonHall"}, {"shrt", "RightTurn"},
            {"shrc", "RoomCrossing"}, {"shsd", "StairsDown"}, {"shstart", "StartPiece"}, {"shs", "Straight"},
            {"shssd", "StraightStairsDown"},
            {"nebcr", "BridgeCrossing"}, {"nebef", "BridgeEndFiller"}, {"nebs", "BridgeStraight"},
            {"neccs", "CastleCorridorStairsPiece"}, {"nectb", "CastleCorridorTBalconyPiece"}, {"nece", "CastleEntrance"},
            {"nescsc", "CastleSmallCorridorCrossingPiece"}, {"nesclt", "CastleSmallCorridorLeftTurnPiece"},
            {"nesc", "CastleSmallCorridorPiece"}, {"nescrt", "CastleSmallCorridorRightTurnPiece"},
            {"necsr", "CastleStalkRoom"}, {"nemt", "MonsterThrone"}, {"nerc", "RoomCrossing"}, {"nesr", "StairsRoom"},
            {"nestart", "StartPiece"},
            {"ecp", "EndCityPiece"}, {"wmp", "WoodlandMansionPiece"},
        };
        for (var piece : pieces)
            PIECE_CLASSES.put(piece[0], piece[1]);
    }

    static MC_MinecraftServer server;

    public static void main(String[] args) throws Exception {
        var fixturePath = Path.of(args[0]);
        long seed = Long.parseLong(args[1]);
        boolean structures = Boolean.parseBoolean(args[2]);
        var version = args[3];
        boolean create = args.length > 4 && args[4].equals("create");

        JsonObject fixture;
        try (var reader = Files.newBufferedReader(fixturePath, StandardCharsets.UTF_8)) {
            fixture = JsonParser.parseReader(reader).getAsJsonObject();
        }

        var cases = new LinkedHashMap<String, List<JsonObject>>();
        for (var section : SECTIONS.entrySet()) {
            if (section.getValue() != structures || !fixture.has(section.getKey()))
                continue;
            for (var element : fixture.getAsJsonArray(section.getKey())) {
                var entry = element.getAsJsonObject();
                if (entry.get("seed").getAsLong() == seed)
                    cases.computeIfAbsent(section.getKey(), name -> new ArrayList<>()).add(entry);
            }
        }
        if (cases.isEmpty()) {
            System.out.println("No cases for seed " + seed + " with structures " + structures + ".");
            return;
        }

        if (create) {
            // Creates the world, which picks its spawn (generating the chunks around it), and saves it. The caller then
            // deletes the world's chunks, so that captures start without any.
            try {
                startServer(seed, structures);
                onServer(() -> server.MC_MinecraftServer_saveEverything(true, true, true));
                System.out.println("Created the world for seed " + seed + " with structures " + structures + ".");
                System.out.flush();
                Runtime.getRuntime().halt(0);
            } catch (Throwable e) {
                e.printStackTrace();
                System.out.flush();
                Runtime.getRuntime().halt(1);
            }
        }

        var report = new ArrayList<String>();
        try {
            startServer(seed, structures);
            // Like the /tick freeze the reference worlds were loaded under: force-loaded chunks tick no blocks or fluids.
            onServer(() -> {
                server.MC_MinecraftServer_tickRateManager().MC_ServerTickRateManager_setFrozen(true);
                return null;
            });
            for (var section : cases.entrySet()) {
                for (var entry : section.getValue()) {
                    var before = entry.deepCopy();
                    capture(section.getKey(), entry);
                    report.add(compare(section.getKey(), before, entry));
                }
            }
        } catch (Throwable e) {
            e.printStackTrace();
            System.out.flush();
            Runtime.getRuntime().halt(1);
        }

        fixture.addProperty("version", version);
        var gson = new GsonBuilder().setPrettyPrinting().disableHtmlEscaping().create();
        Files.writeString(fixturePath, gson.toJson(fixture) + "\n", StandardCharsets.UTF_8);
        System.out.println("Captured seed " + seed + " with structures " + structures + ":");
        report.forEach(System.out::println);
        System.out.println("Wrote " + fixturePath);
        System.out.flush();
        // The world is thrown away, so skip the server's save on exit.
        Runtime.getRuntime().halt(0);
    }

    // One line per case: the case's inputs, then whether its captured values are what the fixture held.
    static String compare(String section, JsonObject before, JsonObject after) {
        var changes = new ArrayList<String>();
        for (var property : after.entrySet()) {
            var old = before.get(property.getKey());
            if (old == null || !sameValue(old, property.getValue()))
                changes.add(property.getKey() + " " + old + " -> " + property.getValue());
        }
        return "  " + section + " " + before + (changes.isEmpty() ? ": unchanged" : ": CHANGED " + String.join(", ", changes));
    }

    // Numbers compare by value, since the fixture may spell them differently (64 or 64.0).
    static boolean sameValue(JsonElement a, JsonElement b) {
        if (a.isJsonPrimitive() && b.isJsonPrimitive() && a.getAsJsonPrimitive().isNumber() && b.getAsJsonPrimitive().isNumber())
            return new java.math.BigDecimal(a.getAsString()).compareTo(new java.math.BigDecimal(b.getAsString())) == 0;
        return a.equals(b);
    }

    // A capture runs on the server thread, so no tick (and no chunk unload) happens in the middle of it, except while it
    // waits for the server to load the chunks of a server world.
    static void capture(String section, JsonObject entry) {
        try {
            switch (section) {
                case "fullChunks" -> fullChunk(entry);
                case "structureBlocks" -> structureBlocks(entry);
                default -> onServer(() -> {
                    try {
                        switch (section) {
                            case "router" -> router(entry);
                            case "biomes" -> biome(entry);
                            case "chunks" -> surfaceChunk(entry);
                            case "carvedChunks" -> carvedChunk(entry);
                            case "decoratedChunks" -> decoratedChunk(entry);
                            case "spawns" -> spawn(entry);
                            case "litChunks" -> litChunk(entry);
                            case "structurePieces" -> structurePieces(entry);
                            case "treasureMaps" -> treasureMap(entry);
                            default -> throw new IllegalArgumentException(section);
                        }
                    } catch (ReflectiveOperationException e) {
                        throw new IllegalStateException(e);
                    }
                    return null;
                });
            }
        } catch (Exception e) {
            throw new RuntimeException("Capturing " + section + " " + entry + " failed", e);
        }
    }

    // ---------------------------------------------------------------- server

    static void startServer(long seed, boolean structures) throws Exception {
        Files.writeString(Path.of("eula.txt"), "eula=true\n");
        // No watchdog, since a capture runs on the server thread for as long as its chunks take, and no pausing while
        // nobody is online, since force-loaded chunks load as the server ticks.
        Files.writeString(Path.of("server.properties"), String.join("\n",
            "level-seed=" + seed, "generate-structures=" + structures, "online-mode=false", "server-port=0",
            "max-tick-time=-1", "pause-when-empty-seconds=-1", "spawn-protection=0", "sync-chunk-writes=false",
            "view-distance=2", "simulation-distance=2","enable-jmx-monitoring=false", "enable-rcon=false", "enable-query=false", ""));

        net.minecraft.server.Main.main(new String[]{"--nogui"});

        // Main keeps the server only in its shutdown hook (which halts it), so find it there.
        var hooksField = Class.forName("java.lang.ApplicationShutdownHooks").getDeclaredField("hooks");
        hooksField.setAccessible(true);
        @SuppressWarnings("unchecked")
        var hooks = (Map<Thread, Thread>) hooksField.get(null);
        for (var hook : new ArrayList<>(hooks.keySet())) {
            if (hook.getClass().getName().equals("net.minecraft.server.Main$1")) {
                var field = hook.getClass().getDeclaredField("MC_Main_1_dedicatedServer");
                field.setAccessible(true);
                server = (MC_MinecraftServer) field.get(hook);
            }
        }
        if (server == null)
            throw new IllegalStateException("The dedicated server didn't start.");

        while (!server.MC_MinecraftServer_isReady())
            Thread.sleep(50);
    }

    static <T> T onServer(Supplier<T> work) {
        return server.MC_BlockableEventLoop_submit(work).join();
    }

    /**
     * Full chunks of a server world: force-loaded, as /forceload does, and read once the server ticks them. A chunk is
     * post-processed (its shape updates, such as fence connections) only when it starts ticking, after its neighbors are
     * full.
     */
    static Map<Long, MC_ChunkAccess> serverWorldChunks(MC_ServerLevel level, List<int[]> positions) throws InterruptedException {
        onServer(() -> {
            for (var position : positions)
                level.MC_ServerLevel_setChunkForced(position[0], position[1], true);
            return null;
        });
        while (!onServer(() -> positions.stream().allMatch(position ->
                level.MC_ServerLevel_isPositionTickingWithEntitiesLoaded(MC_ChunkPos.MC_ChunkPos_asLong(position[0], position[1])))))
            Thread.sleep(50);
        return onServer(() -> {
            var chunks = new HashMap<Long, MC_ChunkAccess>();
            for (var position : positions)
                chunks.put(MC_ChunkPos.MC_ChunkPos_asLong(position[0], position[1]), chunk(level, position[0], position[1], MC_ChunkStatus.MC_ChunkStatus_FULL));
            return chunks;
        });
    }

    static MC_ServerLevel level(JsonObject entry) {
        var name = entry.has("dimension") ? entry.get("dimension").getAsString() : "overworld";
        var key = switch (name) {
            case "overworld" -> MC_Level.MC_Level_OVERWORLD;
            case "nether" -> MC_Level.MC_Level_NETHER;
            case "end" -> MC_Level.MC_Level_END;
            default -> throw new IllegalArgumentException(name);
        };
        return server.MC_MinecraftServer_getLevel(key);
    }

    static MC_ChunkAccess chunk(MC_ServerLevel level, int chunkX, int chunkZ, MC_ChunkStatus status) {
        return level.MC_ServerLevel_getChunkSource().MC_ServerChunkCache_getChunk(chunkX, chunkZ, status, true);
    }

    /** A chunk generated to exactly a status, failing if something (such as spawn selection) took it further already. */
    static MC_ChunkAccess chunkAt(MC_ServerLevel level, int chunkX, int chunkZ, MC_ChunkStatus status) {
        var chunk = chunk(level, chunkX, chunkZ, status);
        var actual = chunk.MC_ChunkAccess_getPersistedStatus();
        if (actual != status) {
            throw new IllegalStateException("Chunk " + chunkX + ", " + chunkZ + " is at " + actual.MC_ChunkStatus_getName() +
                " instead of " + status.MC_ChunkStatus_getName() + "; the server generated it before the capture.");
        }
        return chunk;
    }

    // ---------------------------------------------------------------- captures

    // Vanilla: RandomState.create(overworld, seed).router().<field>().compute(new SinglePointContext(x, y, z)).
    static void router(JsonObject entry) {
        var random = MC_RandomState.MC_RandomState_create(server.MC_MinecraftServer_registryAccess(),
            MC_NoiseGeneratorSettings.MC_NoiseGeneratorSettings_OVERWORLD, entry.get("seed").getAsLong());
        var router = random.MC_RandomState_router();
        var point = new MC_SinglePointContext(entry.get("x").getAsInt(), entry.get("y").getAsInt(), entry.get("z").getAsInt());
        entry.addProperty("continents", router.MC_NoiseRouter_continents().MC_DensityFunction_compute(point));
        entry.addProperty("erosion", router.MC_NoiseRouter_erosion().MC_DensityFunction_compute(point));
        entry.addProperty("depth", router.MC_NoiseRouter_depth().MC_DensityFunction_compute(point));
        entry.addProperty("finalDensity", router.MC_NoiseRouter_finalDensity().MC_DensityFunction_compute(point));
        entry.addProperty("preliminarySurfaceLevel", router.MC_NoiseRouter_preliminarySurfaceLevel().MC_DensityFunction_compute(point));
    }

    // Vanilla: the overworld's multi-noise biome source, getNoiseBiome(quartX, quartY, quartZ, sampler).
    static void biome(JsonObject entry) {
        var random = MC_RandomState.MC_RandomState_create(server.MC_MinecraftServer_registryAccess(),
            MC_NoiseGeneratorSettings.MC_NoiseGeneratorSettings_OVERWORLD, entry.get("seed").getAsLong());
        var source = level(entry).MC_ServerLevel_getChunkSource().MC_ServerChunkCache_getGenerator().MC_ChunkGenerator_getBiomeSource();
        var biome = source.MC_BiomeSource_getNoiseBiome(entry.get("quartX").getAsInt(), entry.get("quartY").getAsInt(),
            entry.get("quartZ").getAsInt(), random.MC_RandomState_sampler());
        entry.addProperty("biome", biome.MC_Holder_getRegisteredName());
    }

    // The chunk after the biomes, noise and surface steps: its block names and quart biomes.
    static void surfaceChunk(JsonObject entry) {
        var chunk = chunkAt(level(entry), entry.get("chunkX").getAsInt(), entry.get("chunkZ").getAsInt(), MC_ChunkStatus.MC_ChunkStatus_SURFACE);
        entry.addProperty("blocks", sha256(blockNames(chunk)));
        entry.addProperty("biomes", sha256(biomeNames(chunk)));
    }

    // The chunk after the carvers step.
    static void carvedChunk(JsonObject entry) {
        var chunk = chunkAt(level(entry), entry.get("chunkX").getAsInt(), entry.get("chunkZ").getAsInt(), MC_ChunkStatus.MC_ChunkStatus_CARVERS);
        entry.addProperty("blocks", sha256(blockNames(chunk)));
    }

    // The chunk decorated with its neighbors at the carvers step (only the center is decorated).
    static void decoratedChunk(JsonObject entry) {
        var level = level(entry);
        int chunkX = entry.get("chunkX").getAsInt(), chunkZ = entry.get("chunkZ").getAsInt();
        for (var dz = -1; dz <= 1; dz++)
            for (var dx = -1; dx <= 1; dx++)
                chunkAt(level, chunkX + dx, chunkZ + dz, MC_ChunkStatus.MC_ChunkStatus_CARVERS);
        var chunk = chunkAt(level, chunkX, chunkZ, MC_ChunkStatus.MC_ChunkStatus_FEATURES);
        entry.addProperty("blocks", sha256(blockNames(chunk)));
    }

    // A full chunk of a server world.
    static void fullChunk(JsonObject entry) throws InterruptedException {
        int chunkX = entry.get("chunkX").getAsInt(), chunkZ = entry.get("chunkZ").getAsInt();
        var chunk = serverWorldChunks(level(entry), List.of(new int[]{chunkX, chunkZ})).get(MC_ChunkPos.MC_ChunkPos_asLong(chunkX, chunkZ));
        entry.addProperty("blocks", onServer(() -> sha256(blockNames(chunk))));
    }

    // The spawn the server picked for the new world (level.dat's spawn).
    static void spawn(JsonObject entry) {
        var pos = server.MC_MinecraftServer_getRespawnData().MC_RespawnData_pos();
        entry.addProperty("x", pos.MC_Vec3i_getX());
        entry.addProperty("y", pos.MC_Vec3i_getY());
        entry.addProperty("z", pos.MC_Vec3i_getZ());
    }

    // The chunk's sky light, then block light, per section bottom up in vanilla's nibble layout, once the 7x7 chunks around
    // it are carved, the 5x5 decorated (z then x ascending) and the 3x3 lit (z then x ascending).
    static void litChunk(JsonObject entry) {
        var level = level(entry);
        int chunkX = entry.get("chunkX").getAsInt(), chunkZ = entry.get("chunkZ").getAsInt();
        for (var dz = -3; dz <= 3; dz++)
            for (var dx = -3; dx <= 3; dx++)
                chunkAt(level, chunkX + dx, chunkZ + dz, MC_ChunkStatus.MC_ChunkStatus_CARVERS);
        for (var dz = -2; dz <= 2; dz++)
            for (var dx = -2; dx <= 2; dx++)
                chunkAt(level, chunkX + dx, chunkZ + dz, MC_ChunkStatus.MC_ChunkStatus_FEATURES);
        for (var dz = -1; dz <= 1; dz++)
            for (var dx = -1; dx <= 1; dx++)
                chunk(level, chunkX + dx, chunkZ + dz, MC_ChunkStatus.MC_ChunkStatus_LIGHT);

        var light = new ByteArrayOutputStream();
        var lightEngine = level.MC_Level_getLightEngine();
        for (var layer : List.of(MC_LightLayer.MC_LightLayer_SKY, MC_LightLayer.MC_LightLayer_BLOCK)) {
            var listener = lightEngine.MC_LevelLightEngine_getLayerListener(layer);
            int minSection = level.MC_LevelHeightAccessor_getMinSectionY(), sections = level.MC_LevelHeightAccessor_getSectionsCount();
            for (var section = minSection; section < minSection + sections; section++) {
                var nibbles = new byte[2048];
                for (var index = 0; index < 4096; index++) {
                    int x = index & 15, z = (index >> 4) & 15, y = index >> 8;
                    var value = listener.MC_LayerLightEventListener_getLightValue(
                        new MC_BlockPos((chunkX << 4) + x, (section << 4) + y, (chunkZ << 4) + z));
                    nibbles[index >> 1] |= (byte) (value << ((index & 1) << 2));
                }
                light.writeBytes(nibbles);
            }
        }
        entry.addProperty("light", sha256(light.toByteArray()));
    }

    // Vanilla: Structure.generate's piece list for the start in the chunk (the chunk's structure starts).
    static void structurePieces(JsonObject entry) throws ReflectiveOperationException {
        var start = start(entry);
        var lines = new ArrayList<String>();
        for (var piece : start.MC_StructureStart_getPieces())
            lines.add(describe((MC_StructurePiece) piece));
        entry.addProperty("pieceCount", lines.size());
        entry.addProperty("pieces", sha256(String.join("\n", lines)));
    }

    // The block state ids (little-endian uint16) inside each piece box, in piece order and y, z, x order, once every chunk
    // the structure reaches is full.
    static void structureBlocks(JsonObject entry) throws InterruptedException {
        var level = level(entry);
        var start = onServer(() -> start(entry));
        var box = start.MC_StructureStart_getBoundingBox();
        var positions = new ArrayList<int[]>();
        for (var x = box.MC_BoundingBox_minX() >> 4; x <= box.MC_BoundingBox_maxX() >> 4; x++)
            for (var z = box.MC_BoundingBox_minZ() >> 4; z <= box.MC_BoundingBox_maxZ() >> 4; z++)
                positions.add(new int[]{x, z});
        var chunks = serverWorldChunks(level, positions);
        onServer(() -> {
            hashStructureBlocks(entry, level, start, chunks);
            return null;
        });
    }

    static void hashStructureBlocks(JsonObject entry, MC_ServerLevel level, MC_StructureStart start, Map<Long, MC_ChunkAccess> chunks) {

        int minY = level.MC_LevelHeightAccessor_getMinY(), maxY = minY + level.MC_LevelHeightAccessor_getHeight() - 1;
        var ids = new ByteArrayOutputStream();
        for (var element : start.MC_StructureStart_getPieces()) {
            var pieceBox = ((MC_StructurePiece) element).MC_StructurePiece_getBoundingBox();
            for (var y = Math.max(pieceBox.MC_BoundingBox_minY(), minY); y <= Math.min(pieceBox.MC_BoundingBox_maxY(), maxY); y++) {
                for (var z = pieceBox.MC_BoundingBox_minZ(); z <= pieceBox.MC_BoundingBox_maxZ(); z++) {
                    for (var x = pieceBox.MC_BoundingBox_minX(); x <= pieceBox.MC_BoundingBox_maxX(); x++) {
                        var chunk = chunks.get(MC_ChunkPos.MC_ChunkPos_asLong(x >> 4, z >> 4));
                        var id = MC_Block.MC_Block_getId(chunk.MC_BlockGetter_getBlockState(new MC_BlockPos(x, y, z)));
                        ids.write(id);
                        ids.write(id >> 8);
                    }
                }
            }
        }
        entry.addProperty("blocks", sha256(ids.toByteArray()));
    }

    // Vanilla: /loot spawn ... loot minecraft:chests/shipwreck_map. Its exploration_map function finds the structure, then
    // creates the map at it and renders its biome preview.
    static void treasureMap(JsonObject entry) {
        var level = level(entry);
        var tag = MC_TagKey.MC_TagKey_create(MC_Registries.MC_Registries_STRUCTURE, MC_Identifier.MC_Identifier_parse(entry.get("tag").getAsString()));
        var origin = new MC_BlockPos(entry.get("x").getAsInt(), entry.get("y").getAsInt(), entry.get("z").getAsInt());
        var target = level.MC_ServerLevel_findNearestMapStructure(tag, origin, entry.get("radius").getAsInt(), entry.get("skipKnown").getAsBoolean());
        entry.addProperty("targetX", target.MC_Vec3i_getX());
        entry.addProperty("targetY", target.MC_Vec3i_getY());
        entry.addProperty("targetZ", target.MC_Vec3i_getZ());

        var map = MC_MapItem.MC_MapItem_create(level, target.MC_Vec3i_getX(), target.MC_Vec3i_getZ(), entry.get("zoom").getAsByte(), true, true);
        MC_MapItem.MC_MapItem_renderBiomePreviewMap(level, map);
        var data = MC_MapItem.MC_MapItem_getSavedData(map, level);
        entry.addProperty("centerX", data.MC_MapItemSavedData_centerX);
        entry.addProperty("centerZ", data.MC_MapItemSavedData_centerZ);
        entry.addProperty("colors", sha256(data.MC_MapItemSavedData_colors));
    }

    // ---------------------------------------------------------------- structures

    static MC_StructureStart start(JsonObject entry) {
        var structure = entry.get("structure").getAsString();
        var chunk = chunk(level(entry), entry.get("chunkX").getAsInt(), entry.get("chunkZ").getAsInt(), MC_ChunkStatus.MC_ChunkStatus_STRUCTURE_STARTS);
        MC_Registry structures = server.MC_MinecraftServer_registryAccess().MC_RegistryAccess_lookupOrThrow(MC_Registries.MC_Registries_STRUCTURE);
        for (var start : ((Map<?, ?>) chunk.MC_ChunkAccess_getAllStarts()).entrySet()) {
            if (structures.MC_Registry_getKey(start.getKey()).toString().equals(structure))
                return (MC_StructureStart) start.getValue();
        }
        throw new IllegalStateException("No " + structure + " starts in chunk " + entry.get("chunkX") + ", " + entry.get("chunkZ"));
    }

    // One line per piece, as Obsidian's VanillaStructureGeneration test describes its own pieces.
    static String describe(MC_StructurePiece piece) throws ReflectiveOperationException {
        var type = ((MC_Identifier) MC_BuiltInRegistries.MC_BuiltInRegistries_STRUCTURE_PIECE.MC_Registry_getKey(piece.MC_StructurePiece_getType())).MC_Identifier_getPath();
        var className = PIECE_CLASSES.get(type);
        if (className == null)
            throw new IllegalStateException("Add Obsidian's class for structure piece type " + type + " to PIECE_CLASSES.");

        var parts = new ArrayList<String>(List.of(className, "box " + box(piece.MC_StructurePiece_getBoundingBox())));
        if (piece instanceof MC_PoolElementStructurePiece pool) {
            parts.add(element(pool.MC_PoolElementStructurePiece_getElement()));
            parts.add(rigid(pool.MC_PoolElementStructurePiece_getElement().MC_StructurePoolElement_getProjection()) ? "rigid" : "terrain_matching");
            parts.add("pos " + position(pool.MC_PoolElementStructurePiece_getPosition()));
            parts.add(pool.MC_PoolElementStructurePiece_getRotation().name());
            parts.add("ground " + pool.MC_PoolElementStructurePiece_getGroundLevelDelta());
            var junctions = new ArrayList<String>();
            for (var element : pool.MC_PoolElementStructurePiece_getJunctions()) {
                var junction = (MC_JigsawJunction) element;
                junctions.add(junction.MC_JigsawJunction_getSourceX() + "," + junction.MC_JigsawJunction_getSourceGroundY() + "," +
                    junction.MC_JigsawJunction_getSourceZ() + "," + junction.MC_JigsawJunction_getDeltaY() + "," +
                    (rigid(junction.MC_JigsawJunction_getDestProjection()) ? 1 : 0));
            }
            parts.add("junctions " + String.join(";", junctions));
        } else if (piece instanceof MC_TemplateStructurePiece template) {
            parts.add((String) field(MC_TemplateStructurePiece.class, "MC_TemplateStructurePiece_templateName").get(template));
            parts.add("pos " + position(template.MC_TemplateStructurePiece_templatePosition()));
            var settings = template.MC_TemplateStructurePiece_placeSettings();
            parts.add(settings.MC_StructurePlaceSettings_getRotation().name());
            parts.add(settings.MC_StructurePlaceSettings_getMirror().name());
            parts.add("pivot " + position(settings.MC_StructurePlaceSettings_getRotationPivot()));
        } else {
            var orientation = piece.MC_StructurePiece_getOrientation();
            parts.add(orientation == null ? "none" : orientation.MC_Direction_getSerializedName());
            parts.add("depth " + piece.MC_StructurePiece_getGenDepth());
        }
        return String.join(" | ", parts);
    }

    static String element(MC_StructurePoolElement element) throws ReflectiveOperationException {
        if (element instanceof MC_LegacySinglePoolElement || element instanceof MC_SinglePoolElement) {
            var template = (com.mojang.datafixers.util.Either<?, ?>) field(MC_SinglePoolElement.class, "MC_SinglePoolElement_template").get(element);
            var location = template.left().orElseThrow(() -> new IllegalStateException("Pool element without a template id: " + element));
            return (element instanceof MC_LegacySinglePoolElement ? "legacy:" : "single:") + location;
        }
        if (element instanceof MC_ListPoolElement) {
            var parts = new ArrayList<String>();
            for (var child : (List<?>) field(MC_ListPoolElement.class, "MC_ListPoolElement_elements").get(element))
                parts.add(element((MC_StructurePoolElement) child));
            return "list:[" + String.join(",", parts) + "]";
        }
        if (element instanceof MC_FeaturePoolElement)
            return "feature:" + ((MC_Holder) field(MC_FeaturePoolElement.class, "MC_FeaturePoolElement_feature").get(element)).MC_Holder_getRegisteredName();
        return "empty";
    }

    // By constant name: an obfuscated nested type's canonical name can clash with a field of its outer class.
    static boolean rigid(Enum<?> projection) {
        return projection.name().equals("RIGID");
    }

    static Field field(Class<?> owner, String name) throws NoSuchFieldException {
        var field = owner.getDeclaredField(name);
        field.setAccessible(true);
        return field;
    }

    static String box(MC_BoundingBox box) {
        return box.MC_BoundingBox_minX() + "," + box.MC_BoundingBox_minY() + "," + box.MC_BoundingBox_minZ() + "," +
            box.MC_BoundingBox_maxX() + "," + box.MC_BoundingBox_maxY() + "," + box.MC_BoundingBox_maxZ();
    }

    static String position(MC_BlockPos position) {
        return position.MC_Vec3i_getX() + "," + position.MC_Vec3i_getY() + "," + position.MC_Vec3i_getZ();
    }

    // ---------------------------------------------------------------- hashing

    // Block names in y, z, x order, one per line; every kind of air is minecraft:air.
    static String blockNames(MC_ChunkAccess chunk) {
        var names = new StringJoiner("\n");
        var pos = chunk.MC_ChunkAccess_getPos();
        int minX = pos.MC_ChunkPos_x << 4, minZ = pos.MC_ChunkPos_z << 4;
        int minY = chunk.MC_LevelHeightAccessor_getMinY(), maxY = minY + chunk.MC_LevelHeightAccessor_getHeight();
        for (var y = minY; y < maxY; y++) {
            for (var z = 0; z < 16; z++) {
                for (var x = 0; x < 16; x++) {
                    var state = chunk.MC_BlockGetter_getBlockState(new MC_BlockPos(minX + x, y, minZ + z));
                    names.add(state.MC_BlockStateBase_isAir() ? "minecraft:air"
                        : MC_BuiltInRegistries.MC_BuiltInRegistries_BLOCK.MC_Registry_getKey(state.MC_BlockStateBase_getBlock()).toString());
                }
            }
        }
        return names.toString();
    }

    // Quart biome names in y, z, x order, one per line.
    static String biomeNames(MC_ChunkAccess chunk) {
        var names = new StringJoiner("\n");
        int minQuartY = chunk.MC_LevelHeightAccessor_getMinY() >> 2;
        int maxQuartY = (chunk.MC_LevelHeightAccessor_getMinY() + chunk.MC_LevelHeightAccessor_getHeight()) >> 2;
        for (var quartY = minQuartY; quartY < maxQuartY; quartY++)
            for (var quartZ = 0; quartZ < 4; quartZ++)
                for (var quartX = 0; quartX < 4; quartX++)
                    names.add(chunk.MC_NoiseBiomeSource_getNoiseBiome(quartX, quartY, quartZ).MC_Holder_getRegisteredName());
        return names.toString();
    }

    static String sha256(String text) {
        return sha256(text.getBytes(StandardCharsets.UTF_8));
    }

    static String sha256(byte[] bytes) {
        try {
            return HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(bytes));
        } catch (java.security.NoSuchAlgorithmException e) {
            throw new IllegalStateException(e);
        }
    }
}
