                "shapes",shapes.stream().flatMap(s->s.MC_VoxelShape_toAabbs().stream()).map(b->new double[]{b.MC_AABB_field_minX,b.MC_AABB_field_minY,b.MC_AABB_field_minZ,b.MC_AABB_field_maxX,b.MC_AABB_field_maxY,b.MC_AABB_field_maxZ}).toList(),
                "motion",vector(desired),"allowed",vector(allowed)));
        }
        result.put("collisions",cases);
        Files.writeString(Path.of(args[0]),new GsonBuilder().setPrettyPrinting().create().toJson(result));
    }
}
