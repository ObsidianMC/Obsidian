 */
class PlayerPhysicsFixtures {
    static sun.misc.Unsafe unsafe;
    static Method sweep, collide, air, water, lava, glide;
    static class World extends MC_ServerLevel {
        MC_BlockState surface;
        List<MC_VoxelShape> shapes;
        World() { super(null,null,null,null,null,null,false,0,null,false,null); }
        @Override public MC_BlockState MC_Level_getBlockState(MC_BlockPos pos) { return surface; }
        @Override public List<MC_VoxelShape> MC_CollisionGetter_getEntityCollisions(MC_Entity entity, MC_AABB box) { return List.of(); }
        @Override public Iterable<MC_VoxelShape> MC_CollisionGetter_getBlockCollisions(MC_Entity entity, MC_AABB box) { return shapes; }
        @Override public MC_WorldBorder MC_CollisionGetter_getWorldBorder() { return new MC_WorldBorder(); }
    }
    static class Probe extends MC_LivingEntity {
        boolean ground, ladder, sprint;
        MC_Vec3 accumulated;
        Probe() { super(MC_EntityType.MC_EntityType_field_PLAYER, null); }
        @Override public MC_HumanoidArm MC_LivingEntity_getMainArm() { return MC_HumanoidArm.MC_HumanoidArm_field_RIGHT; }
        @Override public boolean MC_Entity_onGround() { return ground; }
        @Override public boolean MC_LivingEntity_onClimbable() { return ladder; }
        @Override public boolean MC_Entity_isSprinting() { return sprint; }
        @Override public float MC_LivingEntity_getSpeed() { return .1f; }
        @Override protected float MC_LivingEntity_getFlyingSpeed() { return .02f; }
        @Override protected double MC_LivingEntity_getEffectiveGravity() { return .08; }
        @Override public MC_BlockPos MC_Entity_getBlockPosBelowThatAffectsMyMovement() { return MC_BlockPos.MC_BlockPos_field_ZERO; }
        @Override public boolean MC_LivingEntity_hasEffect(MC_Holder<MC_MobEffect> effect) { return false; }
        @Override public MC_MobEffectInstance MC_LivingEntity_getEffect(MC_Holder<MC_MobEffect> effect) { return null; }
        @Override public double MC_LivingEntity_getAttributeValue(MC_Holder<MC_Attribute> attribute) { return attribute == MC_Attributes.MC_Attributes_field_JUMP_STRENGTH ? .42 : attribute == MC_Attributes.MC_Attributes_field_GRAVITY ? .08 : 0; }
        @Override public double MC_Entity_getFluidHeight(MC_TagKey<MC_Fluid> tag) { return .8; }
        @Override public float MC_LivingEntity_maxUpStep() { return .6f; }
        @Override public boolean MC_LivingEntity_isSuppressingSlidingDownLadder() { return false; }
        @Override public void MC_Entity_move(MC_MoverType type, MC_Vec3 movement) {
            accumulated = accumulated.MC_Vec3_add(movement.MC_Vec3_field_x, ground ? 0 : movement.MC_Vec3_field_y, movement.MC_Vec3_field_z);
            if (ground) MC_Entity_setDeltaMovement(new MC_Vec3(movement.MC_Vec3_field_x, 0, movement.MC_Vec3_field_z));
            if (((World)MC_Entity_level()).surface.MC_BlockBehaviour_BlockStateBase_is(MC_Blocks.MC_Blocks_field_SOUL_SAND)) MC_Entity_setDeltaMovement(MC_Entity_getDeltaMovement().MC_Vec3_multiply(.4f,1,.4f));
        }
    }
    static void field(Object target, Class<?> type, String name, Object value) throws Exception {
        var field=type.getDeclaredField(name); field.setAccessible(true); field.set(target,value);
    }
    static Method method(Class<?> type, String name, Class<?>... args) throws Exception {
        var method=type.getDeclaredMethod(name,args); method.setAccessible(true); return method;
    }
    static double[] vector(MC_Vec3 v) { return new double[]{v.MC_Vec3_field_x,v.MC_Vec3_field_y,v.MC_Vec3_field_z}; }
    static Probe probe(MC_Block surface) throws Exception {
        var world=(World)unsafe.allocateInstance(World.class);world.surface=surface.MC_Block_defaultBlockState();world.shapes=List.of();
        var p=(Probe)unsafe.allocateInstance(Probe.class);field(p,MC_Entity.class,"MC_Entity_field_level",world);field(p,MC_Entity.class,"MC_Entity_field_position",MC_Vec3.MC_Vec3_field_ZERO);
