            }
            motions.put(scenario,rows);
        }
        result.put("travel",motions);
        var mouse = new MC_SmoothDouble();
        var mouseRows = new ArrayList<double[]>();
        for (var delta : new double[]{10,0,0,-3,0,0}) mouseRows.add(new double[]{delta, mouse.MC_SmoothDouble_getNewDeltaValue(delta, 1.0/60)});
        result.put("mouse", mouseRows);
        var offsets = new ArrayList<Object>();
        for (var block : List.of(MC_Blocks.MC_Blocks_field_BAMBOO, MC_Blocks.MC_Blocks_field_DANDELION, MC_Blocks.MC_Blocks_field_SHORT_GRASS)) {
            for (var pos : List.of(new MC_BlockPos(13,5,-7),new MC_BlockPos(-987,0,324))) {
                var state = block.MC_Block_defaultBlockState();
                offsets.add(Map.of("block",MC_BuiltInRegistries.MC_BuiltInRegistries_field_BLOCK.MC_Registry_getKey(block).toString(),"x",pos.MC_Vec3i_getX(),"z",pos.MC_Vec3i_getZ(),
                    "offset",vector(state.MC_BlockBehaviour_BlockStateBase_getOffset(pos).MC_Vec3_subtract(state.MC_BlockBehaviour_BlockStateBase_getOffset(MC_BlockPos.MC_BlockPos_field_ZERO)))));
            }
        }
        result.put("offsets", offsets);
        var cases=new ArrayList<Object>();
        MC_AABB box=new MC_AABB(.2,1,.2,.8,2.8,.8);
        for(var scenario:List.of("slab","stair","fence","corner_x","corner_z","ceiling","epsilon")) {
            List<MC_VoxelShape> shapes=new ArrayList<>();shapes.add(MC_Shapes.MC_Shapes_box(-4,0,-4,4,1,4));
            MC_Vec3 desired=new MC_Vec3(.8,-.0784,.25);
            switch(scenario) {
                case "slab" -> shapes.add(MC_Shapes.MC_Shapes_box(1,1,0,2,1.5,1));
                case "stair" -> {shapes.add(MC_Shapes.MC_Shapes_box(1,1,0,2,1.5,1));shapes.add(MC_Shapes.MC_Shapes_box(1.5,1.5,0,2,2,1));}
                case "fence" -> shapes.add(MC_Shapes.MC_Shapes_box(1.375,1,.375,1.625,2.5,.625));
                case "corner_x","corner_z" -> {shapes.add(MC_Shapes.MC_Shapes_box(1,1,1,2,3,2));desired=scenario.equals("corner_x")?new MC_Vec3(.8,-.0784,.7):new MC_Vec3(.7,-.0784,.8);}
                case "ceiling" -> {shapes.add(MC_Shapes.MC_Shapes_box(1,1,0,2,1.5,1));shapes.add(MC_Shapes.MC_Shapes_box(0,3,0,2,4,2));}
                case "epsilon" -> desired=new MC_Vec3(1e-8,-.0784,0);
            }
            var p=probe(MC_Blocks.MC_Blocks_field_STONE);p.ground=true;field(p,MC_Entity.class,"MC_Entity_field_bb",box);((World)p.MC_Entity_level()).shapes=shapes;
            var allowed=(MC_Vec3)collide.invoke(p,desired);
