    }
    public static void main(String[] args) throws Exception {
        MC_SharedConstants.MC_SharedConstants_tryDetectVersion();MC_Bootstrap.MC_Bootstrap_bootStrap();
        var f=sun.misc.Unsafe.class.getDeclaredField("theUnsafe");f.setAccessible(true);unsafe=(sun.misc.Unsafe)f.get(null);
        sweep=method(MC_Entity.class,"MC_Entity_collideWithShapes",MC_Vec3.class,MC_AABB.class,List.class);
        collide=method(MC_Entity.class,"MC_Entity_collide",MC_Vec3.class);
        air=method(MC_LivingEntity.class,"MC_LivingEntity_travelInAir",MC_Vec3.class);
        water=method(MC_LivingEntity.class,"MC_LivingEntity_travelInWater",MC_Vec3.class,double.class,boolean.class,double.class);
        lava=method(MC_LivingEntity.class,"MC_LivingEntity_travelInLava",MC_Vec3.class,double.class,boolean.class,double.class);
        glide=method(MC_LivingEntity.class,"MC_LivingEntity_updateFallFlyingMovement",MC_Vec3.class);
        var result=new LinkedHashMap<String,Object>();
        var motions=new LinkedHashMap<String,Object>();
        for(var scenario:List.of("stone","ice","soul_sand","air","water","water_sprint","lava","glide","climb")) {
            var p=probe(scenario.equals("ice")?MC_Blocks.MC_Blocks_field_ICE:scenario.equals("soul_sand")?MC_Blocks.MC_Blocks_field_SOUL_SAND:MC_Blocks.MC_Blocks_field_STONE);
            p.ground=List.of("stone","ice","soul_sand").contains(scenario);p.ladder=scenario.equals("climb");
            p.sprint=scenario.equals("water_sprint");
            if(scenario.equals("glide"))p.MC_Entity_setDeltaMovement(new MC_Vec3(.5,-.1,.5));
            if(p.ground)p.MC_Entity_setDeltaMovement(new MC_Vec3(0,-.08*.98f,0));
            if(p.ladder)p.MC_Entity_setDeltaMovement(new MC_Vec3(.4,-.3,.4));
            var rows=new ArrayList<Object>();
            for(int i=0;i<5;i++) {
                if(scenario.startsWith("water")) water.invoke(p,new MC_Vec3(0,0,.98f),.08,p.MC_Entity_getDeltaMovement().MC_Vec3_field_y<=0,0);
                else if(scenario.equals("lava")) lava.invoke(p,new MC_Vec3(0,0,.98f),.08,p.MC_Entity_getDeltaMovement().MC_Vec3_field_y<=0,0);
                else if(scenario.equals("glide")) { p.MC_Entity_setDeltaMovement((MC_Vec3)glide.invoke(p,p.MC_Entity_getDeltaMovement()));p.accumulated=p.accumulated.MC_Vec3_addVector(p.MC_Entity_getDeltaMovement()); }
                else air.invoke(p,new MC_Vec3(0,0,.98f));
